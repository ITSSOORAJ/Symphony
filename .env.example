# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database connection (MongoDB)
MONGODB_URI="mongodb://localhost:27017/kerala_events"

# JWT Authentication Secret
JWT_SECRET="kerala_vanamali_events_jwt_secret_key_2026"

# Nodemailer / SMTP Configuration (for sending email notifications & invoices)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="vanamali.events.kerala@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Vanamali Events Kerala <vanamali.events.kerala@gmail.com>"
